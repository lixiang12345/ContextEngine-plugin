# Copy to /root/ce-services/ce.env with mode 0600. Never commit the real key.
CE_API_KEY=replace-with-a-random-secret

EMBED_MODEL=/root/ce-models/Qwen3-Embedding-0.6B
EMBED_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
RERANK_MODEL=/root/ce-models/Qwen3-Reranker-0.6B
RERANK_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473

CE_MAX_EMBED_CHARS=8000
CE_MAX_EMBED_BATCH=64
CE_MAX_RERANK_DOCS=64
CE_RERANK_BATCH_SIZE=8
CE_RERANK_MAX_LENGTH=4096
CE_RERANK_INSTRUCTION="Given a programming task or natural language question about a codebase, retrieve the most relevant source code implementation."

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
