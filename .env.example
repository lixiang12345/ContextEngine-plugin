# Required runtime store: PostgreSQL with the pgvector extension.
# Local default after `npm run db:up`.
CONTEXTENGINE_DATABASE_URL=postgresql://contextengine:contextengine@127.0.0.1:54329/contextengine

# HTTP service (required for `contextengine-http` / `contextengine http`).
# Keep this secret outside source control. HTTP refuses to start without it
# unless CONTEXTENGINE_HTTP_ALLOW_UNAUTHENTICATED=1 is explicitly set.
CONTEXTENGINE_HTTP_API_KEY=
# Multi-principal deployments use a JSON array. When set, newly created
# workspaces are private to their creator and can be shared with reader/writer/
# owner permissions. The legacy single key remains an all-workspace operator.
# CONTEXTENGINE_HTTP_API_KEYS=[{"principal_id":"alice","token":"replace-me"},{"principal_id":"ops","token":"replace-me-too","role":"operator"}]
# Optional OAuth 2.0/OIDC JWT access tokens. Issuer and audience are required
# together. JWKS discovery is used unless an explicit HTTPS URL is supplied.
# API keys remain valid when OIDC is enabled. Only explicitly mapped groups can
# grant service-wide operator access; all other verified subjects are users.
# CONTEXTENGINE_OIDC_ISSUER=https://identity.example.com/realms/acme
# CONTEXTENGINE_OIDC_AUDIENCE=contextengine-api
# CONTEXTENGINE_OIDC_JWKS_URL=https://identity.example.com/realms/acme/protocol/openid-connect/certs
# CONTEXTENGINE_OIDC_ALLOWED_ALGORITHMS=RS256
# CONTEXTENGINE_OIDC_GROUPS_CLAIM=groups
# CONTEXTENGINE_OIDC_OPERATOR_GROUPS=contextengine-operators
# CONTEXTENGINE_OIDC_CLOCK_TOLERANCE_SECONDS=30
# CONTEXTENGINE_OIDC_JWKS_CACHE_TTL_MS=300000
# CONTEXTENGINE_OIDC_UNKNOWN_KID_REFRESH_INTERVAL_MS=30000
# CONTEXTENGINE_OIDC_FETCH_TIMEOUT_MS=5000
# Docker Compose publishes the HTTP service on port 8790 by default.
# It binds to loopback by default; use 0.0.0.0 only for a trusted remote deployment.
# CONTEXTENGINE_DOCKER_HTTP_BIND_HOST=127.0.0.1
# CONTEXTENGINE_DOCKER_HTTP_PORT=8790
# CONTEXTENGINE_HTTP_HOST=127.0.0.1
# CONTEXTENGINE_HTTP_PORT=8787
# CONTEXTENGINE_HTTP_MAX_BLOB_BYTES=2097152
# Exact comma-separated browser origins, or * for any origin. Disabled by default.
# CONTEXTENGINE_HTTP_CORS_ORIGINS=https://agent.example.com
# CONTEXTENGINE_HTTP_ALLOW_LOCAL_WORKSPACES=0
# CONTEXTENGINE_LOCAL_ROOT_ALLOWLIST=/srv/repos:/Users/me/Code
# PostgreSQL-backed Remote MCP sessions survive instance restart and can resume
# on any healthy HTTP instance. Set memory only as an explicit single-process
# rollback mode. The PostgreSQL store accepts up to 128 live sessions globally.
# CONTEXTENGINE_MCP_SESSION_STORE=postgres
# CONTEXTENGINE_MCP_SESSION_IDLE_TTL_MS=1800000
# CONTEXTENGINE_MCP_MAX_SESSIONS=128
# Runtime model URLs cannot target private/local networks unless the endpoint
# was configured at startup or this trusted-deployment override is enabled.
# CONTEXTENGINE_HTTP_ALLOW_PRIVATE_MODEL_URLS=0

# Optional read-only GitHub connector. Public repositories do not need a token;
# private repositories require a fine-grained token with Contents: read or a
# GitHub App installation token supplied by an external secret manager.
# CONTEXTENGINE_GITHUB_TOKEN=
# CONTEXTENGINE_GITHUB_API_BASE_URL=https://api.github.com
# CONTEXTENGINE_GITHUB_TIMEOUT_MS=30000
# Enables POST /webhooks/github with HMAC-SHA256 verification. Use a separate,
# random webhook secret; it is never stored in the event inbox.
# CONTEXTENGINE_GITHUB_WEBHOOK_SECRET=
# CONTEXTENGINE_WEBHOOK_POLL_INTERVAL_MS=2000
# CONTEXTENGINE_WEBHOOK_MAX_ATTEMPTS=5

# Durable HTTP index jobs. Every instance scans shared Blob workspaces in
# PostgreSQL, renews an attempt lease while indexing, and can recover work after
# another process exits. Local-path jobs carry persistent executor affinity;
# set a stable ID explicitly for containers or multi-host deployments.
# CONTEXTENGINE_INDEX_JOB_LEASE_MS=300000
# CONTEXTENGINE_INDEX_JOB_POLL_INTERVAL_MS=2000
# CONTEXTENGINE_INDEX_JOB_MAX_ATTEMPTS=5
# CONTEXTENGINE_INDEX_JOB_EXECUTOR_ID=code-host-a
# CONTEXTENGINE_INDEX_ANALYZE_TIMEOUT_MS=30000

# Built-in static website connector. Production crawls require HTTPS, stay on
# one origin/path prefix, obey robots.txt, and enforce bounded pages/bytes.
# Private-network and plain-HTTP crawling is disabled unless a trusted local
# deployment explicitly opts in (primarily useful for integration testing).
# CONTEXTENGINE_WEBSITE_ALLOW_PRIVATE_NETWORK=0
# CONTEXTENGINE_WEBSITE_TIMEOUT_MS=15000

# Optional read-only GitLab connector. Source configuration uses a
# namespace/project path. Prefer a Standard Webhooks signing token for new
# hooks; the legacy secret token remains available during migration.
# CONTEXTENGINE_GITLAB_TOKEN=
# CONTEXTENGINE_GITLAB_API_BASE_URL=https://gitlab.com/api/v4
# CONTEXTENGINE_GITLAB_TIMEOUT_MS=30000
# CONTEXTENGINE_GITLAB_WEBHOOK_SIGNING_TOKEN=
# CONTEXTENGINE_GITLAB_WEBHOOK_SECRET=

# Optional read-only Bitbucket Cloud connector. API credentials use a Bearer
# token; repository source configuration uses workspace/repository slugs.
# CONTEXTENGINE_BITBUCKET_TOKEN=
# CONTEXTENGINE_BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
# CONTEXTENGINE_BITBUCKET_TIMEOUT_MS=30000
# CONTEXTENGINE_BITBUCKET_WEBHOOK_SECRET=

# Optional owner-managed team snapshots and named replication stores. Target
# locations and credentials stay in process configuration; durable interval or
# timezone-aware nightly schedules store only target ids and policy metadata.
# CONTEXTENGINE_SNAPSHOT_STORE=/srv/contextengine/snapshots
# CONTEXTENGINE_SNAPSHOT_REPLICATION_TARGETS={"region-backup":"s3://bucket/prefix"}
# CONTEXTENGINE_SNAPSHOT_REPLICATION_MAX_ATTEMPTS=3
# CONTEXTENGINE_SNAPSHOT_REPLICATION_RETRY_BASE_MS=1000
# CONTEXTENGINE_SNAPSHOT_JOB_POLL_INTERVAL_MS=2000
# CONTEXTENGINE_SNAPSHOT_EVENT_RETENTION_MS=2592000000
# CONTEXTENGINE_SNAPSHOT_EVENT_MAX_PER_JOB=500
# CONTEXTENGINE_SNAPSHOT_STORE_METADATA_TIMEOUT_MS=30000
# CONTEXTENGINE_SNAPSHOT_STORE_TRANSFER_TIMEOUT_MS=0
# CONTEXTENGINE_SNAPSHOT_PROBE_TIMEOUT_MS=10000
# CONTEXTENGINE_S3_ENDPOINT=
# CONTEXTENGINE_S3_FORCE_PATH_STYLE=0
# CONTEXTENGINE_S3_SSE=AES256
# CONTEXTENGINE_S3_KMS_KEY_ID=

# Default model-service profile: an OpenAI-compatible Qwen endpoint exposing
# both POST /v1/embeddings and POST /v1/rerank. Without credentials,
# ContextEngine continues to run in BM25-only mode.
CONTEXTENGINE_EMBEDDING_API_KEY=
CONTEXTENGINE_EMBEDDING_BASE_URL=
CONTEXTENGINE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
CONTEXTENGINE_EMBEDDING_DIMENSIONS=1024
# Number of missing chunks loaded for deterministic length bucketing before
# bounded API batches are sent. This changes throughput, not embedding content.
# CONTEXTENGINE_EMBED_WINDOW=256
# Number of bounded embedding HTTP requests pipelined at once (1..4). The
# default is 1; use 2 only after the remote service passes its resource gate.
# CONTEXTENGINE_EMBED_CONCURRENCY=1
# A root origin is also accepted and normalized to /v1.
# CONTEXTENGINE_API_TIMEOUT_MS=120000
# CONTEXTENGINE_API_RETRIES=2
# Retrieval model calls have a short independent budget and fall back to BM25
# when unavailable. Increase only when the model service is known to be local.
# CONTEXTENGINE_SEARCH_SEMANTIC_TIMEOUT_MS=2000
# CONTEXTENGINE_SEARCH_RERANK_TIMEOUT_MS=2000
# CONTEXTENGINE_SEARCH_BREAKER_FAILURE_THRESHOLD=3
# CONTEXTENGINE_SEARCH_BREAKER_COOLDOWN_MS=30000
# Retain retired/failed index generations for one hour so stale readers can
# refresh before old PostgreSQL namespaces are reclaimed.
# CONTEXTENGINE_GENERATION_RETENTION_MS=3600000
# Source files larger than 512 KiB are skipped by default. Raise this only for
# known large source files; values above 32 MiB are rejected.
# CONTEXTENGINE_MAX_FILE_BYTES=4194304
# Send input_type=document/query to servers that expose the Qwen3 v2 schema.
# Remove this setting for generic OpenAI-compatible gateways.
CONTEXTENGINE_EMBEDDING_INPUT_TYPE=1

# Neural rerank is enabled by default for the combined Qwen endpoint and reuses
# CONTEXTENGINE_EMBEDDING_API_KEY when a separate key is not provided.
CONTEXTENGINE_NEURAL_RERANK=1
CONTEXTENGINE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# CONTEXTENGINE_RERANK_BASE_URL=
# CONTEXTENGINE_RERANK_API_KEY=
CONTEXTENGINE_RERANK_INSTRUCTION=Given a programming task or natural language question about a codebase, retrieve the most relevant source code implementation.

# Alternative short names also work:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_EMBEDDING_MODEL=
